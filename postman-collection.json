{
	"info": {
		"_postman_id": "eureky-lists-api",
		"name": "Eureky Lists, Items & Reminders API",
		"description": "API endpoints for managing lists, list items, and reminders in Eureky. Reminders are now implemented as special list items with scheduling capabilities.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://dev-api.eureky.ai",
			"type": "string",
			"description": "API Base URL for staging environment. Use https://api.eureky.ai for production."
		},
		{
			"key": "base_url_prod",
			"value": "https://api.eureky.ai",
			"type": "string",
			"description": "API Base URL for production environment"
		},
		{
			"key": "auth_token",
			"value": "your-jwt-token-here",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
